<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.BossDashboardController">
    <top>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label fx:id="userLabel" text="Logged in as: Boss">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleLogout" text="Logout" style="-fx-background-color: #ffcccc;" />
                    </children>
                </HBox>
                <TableView fx:id="taskTable" VBox.vgrow="ALWAYS" prefHeight="300.0">
                    <columns>
                        <TableColumn fx:id="colTitle" prefWidth="150.0" text="Title" />
                        <TableColumn fx:id="colDescription" prefWidth="250.0" text="Description" />
                        <TableColumn fx:id="colDeadline" prefWidth="100.0" text="Deadline" />
                        <TableColumn fx:id="colPriority" prefWidth="100.0" text="Priority" />
                        <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </top>
    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <children>
                <Label text="Task Management Form">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>
                <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="200.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Title:" />
                        <TextField fx:id="titleField" GridPane.columnIndex="1" />
                        <Label text="Description:" GridPane.rowIndex="1" />
                        <TextField fx:id="descriptionField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Deadline:" GridPane.rowIndex="2" />
                        <DatePicker fx:id="deadlinePicker" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="Priority:" GridPane.rowIndex="3" />
                        <ComboBox fx:id="priorityCombo" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    </children>
                </GridPane>
                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleCreateTask" prefWidth="100.0" text="Create" />
                        <Button mnemonicParsing="false" onAction="#handleEditTask" prefWidth="100.0" text="Update" />
                        <Button mnemonicParsing="false" onAction="#handleDeleteTask" prefWidth="100.0" text="Delete" textFill="RED" />
                    </children>
                </HBox>
                <Label fx:id="statusLabel" alignment="CENTER" maxWidth="1.7976931348623157E308" text="Ready" />
            </children>
        </VBox>
    </center>
</BorderPane>